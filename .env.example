########################################################################
# Excel Usta Akademisi - Ortam Değişkenleri
# Bu değerler app/config.py tarafından okunur. Değiştirmek isterseniz
# doğrudan bu dosyayı düzenleyebilirsiniz; dosya bulunamazsa uygulama
# yerleşik varsayılan değerlerle çalışmaya devam eder.
########################################################################

APP_NAME=Excel Usta Akademisi
APP_VERSION=1.0.0

# DEBUG=true yapıldığında konsol loglarında daha ayrıntılı (traceback dahil) çıktı alınır.
DEBUG=false
LOG_LEVEL=INFO

DEFAULT_LANGUAGE=tr

# Bir mini sınavda varsayılan olarak kaç soru sorulacağı
QUIZ_QUESTION_COUNT=10

# Bir alıştırma setinde "geçti" sayılmak için gereken yüzde (şu an bilgi amaçlı; UI bunu henüz göstermez)
EXERCISE_PASS_THRESHOLD=70

# Boş bırakılırsa app/data/academy.db kullanılır. Doldurulursa bu URL geçerli olur.
# Örnek: DATABASE_URL=sqlite:////tam/yol/baska_bir_veritabani.db
DATABASE_URL=
