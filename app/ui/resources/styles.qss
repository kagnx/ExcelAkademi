/* ==========================================================================
   Excel Usta Akademisi — Canli Acik Mor Tema
   Doygun, canli acik mor renkler uzerine koyu mor arka planlar
   Renk paleti:
     Canli acik mor: #CE93D8 / #D4A5FF / #F0D0FF
     Koyu mor arka:  #4A148C / #582C8C
     Vurgu:          #BA68C8 / #AB47BC
     Kart arka:      #FFFFFF
     Kart yazi:      #4A148C
   ========================================================================== */

* {
    font-family: "Segoe UI", "Ubuntu", "Noto Sans", sans-serif;
    font-size: 14px;
}

#appRoot {
    background-color: #F3E5F5;
    border-radius: 10px;
}

/* ============================================================
   BASLIK CUBUGU
   ============================================================ */
#titleBar {
    background-color: #582C8C;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom: 3px solid #CE93D8;
}

#titleBarIcon {
    border: 2px solid #CE93D8;
    border-radius: 6px;
    background-color: rgba(206, 147, 216, 0.25);
    padding: 2px;
}

#titleBarText {
    color: #F0D0FF;
    font-size: 16px;
    font-weight: 800;
}

#titleBarVersion {
    color: #CE93D8;
    font-size: 11px;
    font-weight: 600;
}

#titleBarButton {
    background-color: #BA68C8;
    color: #FFFFFF;
    border: 2px solid #CE93D8;
    border-radius: 6px;
    font-size: 17px;
    font-weight: 900;
    min-width: 42px;
    min-height: 34px;
    padding: 2px;
}

#titleBarButton:hover {
    background-color: #CE93D8;
}

#closeButton {
    background-color: #BA68C8;
    color: #FFFFFF;
    border: 2px solid #CE93D8;
}

#closeButton:hover {
    background-color: #C62828;
    border-color: #C62828;
    color: #FFFFFF;
}

/* ============================================================
   SOL PANEL (SIDEBAR)
   ============================================================ */
#sidebar {
    background-color: #4A148C;
    min-width: 240px;
    border-right: 3px solid #CE93D8;
}

#brandIcon {
    background-color: #FFFFFF;
    border-radius: 10px;
    font-size: 22px;
}

#brandTitle {
    color: #E8D0FF;
    font-size: 15px;
    font-weight: 800;
}

#brandSubtitle {
    color: #E8D0FF;
    font-size: 12px;
    font-weight: 700;
}

#brandVersion {
    color: #E8D0FF;
    font-size: 10px;
    font-weight: 700;
}

/* ---- Navigasyon Listesi ---- */
#navList {
    background-color: transparent;
    border: none;
    outline: none;
    font-size: 15px;
    font-weight: 700;
    padding: 4px 8px;
}

#navList::item {
    padding: 12px 14px;
    border-radius: 10px;
    margin: 3px 4px;
    color: #E8D0FF;
    font-weight: 800;
    background-color: transparent;
}

#navList::item:hover {
    background-color: rgba(206, 147, 216, 0.22);
    color: #FFFFFF;
    font-weight: 900;
}

#navList::item:selected {
    background-color: #E8D0FF;
    color: #4A148C;
    font-weight: 900;
}

/* ---- Ilerleme Paneli ---- */
#progressPanel {
    background-color: rgba(206, 147, 216, 0.18);
    border: 2px solid rgba(206, 147, 216, 0.35);
    border-radius: 12px;
}

#progressPanelTitle {
    color: #E8D0FF;
    font-size: 14px;
    font-weight: 900;
}

#progressStatLine {
    color: #E8D0FF;
    font-size: 13px;
    font-weight: 800;
}

#achievementsButton {
    background-color: #FFB300;
    color: #1B1F1D;
    border: none;
    border-radius: 12px;
    padding: 12px;
    font-size: 15px;
    font-weight: 800;
}

#achievementsButton:hover {
    background-color: #FFA000;
}

/* ============================================================
   SAYFA BASLIKLARI
   ============================================================ */
#pageTitle {
    color: #4A148C;
    font-size: 28px;
    font-weight: 800;
}

#pageSubtitle {
    color: #4A148C;
    font-size: 16px;
    font-weight: 700;
}

#sectionHeading {
    color: #4A148C;
    font-size: 18px;
    font-weight: 800;
}

#captionText {
    color: #4A148C;
    font-size: 13px;
    font-weight: 700;
}

/* ============================================================
   BUTONLAR
   ============================================================ */
#primaryButton {
    background-color: #7B1FA2;
    color: #F0D0FF;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 800;
}

#primaryButton:hover {
    background-color: #6A1B9A;
}

#primaryButton:pressed {
    background-color: #4A148C;
}

#secondaryButton {
    background-color: transparent;
    color: #7B1FA2;
    border: 2px solid #CE93D8;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 15px;
    font-weight: 800;
}

#secondaryButton:hover {
    background-color: #F3E5F5;
}

#navButton {
    background-color: rgba(206, 147, 216, 0.25);
    color: #F0D0FF;
    border: 2px solid #CE93D8;
    border-radius: 10px;
    padding: 12px 20px;
    font-size: 15px;
    font-weight: 700;
}

#navButton:hover {
    background-color: rgba(206, 147, 216, 0.45);
}

#linkButton {
    background-color: transparent;
    color: #7B1FA2;
    border: none;
    font-size: 14px;
    font-weight: 800;
    padding: 4px 0px;
}

#linkButton:hover {
    text-decoration: underline;
}

#toggleButton {
    background-color: rgba(206, 147, 216, 0.25);
    color: #F0D0FF;
    border: 2px solid #CE93D8;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    font-weight: 700;
}

#toggleButton:checked {
    background-color: #FFF8E1;
    color: #F57F17;
    border: 2px solid #FFD54F;
    font-weight: 800;
}

#favoriteButton {
    background-color: #FFF8E1;
    color: #E65100;
    border: 2px solid #FFD54F;
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 15px;
    font-weight: 800;
}

#favoriteButton:hover {
    background-color: #FFECB3;
}

/* ============================================================
   ISTATISTIK KARTLARI
   ============================================================ */
#statCard {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 14px;
    padding: 14px;
}

#statCardTitle {
    color: #7B1FA2;
    font-size: 15px;
    font-weight: 700;
}

#statCardValue {
    color: #4A148C;
    font-size: 24px;
    font-weight: 800;
}

/* ============================================================
   SERI ROZETI
   ============================================================ */
#streakBadge {
    background-color: #FFF8E1;
    border: 2px solid #FFD54F;
    border-radius: 12px;
    padding: 10px 18px;
}

#streakCount {
    color: #E65100;
    font-size: 22px;
    font-weight: 800;
}

#streakLabel {
    color: #EF6C00;
    font-size: 13px;
    font-weight: 700;
}

/* ============================================================
   ONIZLEME KARTLARI
   ============================================================ */
#previewCard {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 14px;
}

#previewCardHeader {
    color: #4A148C;
    font-size: 17px;
    font-weight: 800;
}

#previewCardName {
    color: #7B1FA2;
    font-size: 19px;
    font-weight: 800;
}

/* ============================================================
   KONU ANLATIMI KARTI
   ============================================================ */
#lessonCard {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 16px;
}

#lessonCardHeader {
    background-color: #582C8C;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    padding: 14px 18px;
}

#lessonCardHeaderLabel {
    color: #F0D0FF;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
}

#lessonTitle {
    color: #4A148C;
    font-size: 26px;
    font-weight: 800;
}

#lessonDescription {
    color: #37474F;
    font-size: 16px;
    font-weight: 600;
}

#syntaxBox {
    background-color: #F3E5F5;
    border: 2px solid #BA68C8;
    border-radius: 10px;
    padding: 14px;
}

#syntaxLabel {
    color: #4A148C;
    font-size: 16px;
    font-weight: 800;
    font-family: "Consolas", "Courier New", monospace;
}

#whyBox {
    background-color: #F3E5F5;
    border: 2px solid #BA68C8;
    border-radius: 10px;
    padding: 14px;
}

#whyBoxTitle {
    color: #4A148C;
    font-size: 15px;
    font-weight: 800;
}

#whyBoxText {
    color: #37474F;
    font-size: 15px;
    font-weight: 600;
}

#stepsList {
    background-color: transparent;
    border: none;
    color: #4A148C;
    font-size: 15px;
    font-weight: 800;
}

#stepsList::item {
    padding: 6px 4px;
    color: #4A148C;
    font-weight: 800;
}

/* ============================================================
   OZET KART (FLASHCARD)
   ============================================================ */
#summaryCard {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 16px;
}

/* ============================================================
   MINI SINAV DIYALOGU
   ============================================================ */
#quizDialog {
    background-color: #4A148C;
}

#quizProgressLabel {
    color: #CE93D8;
    font-size: 14px;
    font-weight: 700;
}

#quizQuestionLabel {
    color: #F0D0FF;
    font-size: 20px;
    font-weight: 800;
}

#quizChoice {
    font-size: 16px;
    color: #F0D0FF;
    padding: 12px;
    border-radius: 8px;
    background-color: rgba(206, 147, 216, 0.15);
    border: 2px solid rgba(206, 147, 216, 0.30);
}

#quizChoice:hover {
    background-color: rgba(206, 147, 216, 0.30);
}

/* ============================================================
   BASARILAR (ROZETLER)
   ============================================================ */
#achievementCard {
    background-color: #FFFFFF;
    border: 2px solid #FFD54F;
    border-radius: 14px;
    padding: 14px;
}

#achievementCardLocked {
    background-color: rgba(206, 147, 216, 0.20);
    border: 2px dashed #CE93D8;
    border-radius: 14px;
    padding: 14px;
}

#achievementCardLocked QLabel {
    color: #CE93D8;
    font-weight: 600;
}

/* ============================================================
   GIRDI ELEMANLARI
   ============================================================ */
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 10px;
    padding: 11px 14px;
    font-size: 15px;
    color: #4A148C;
    font-weight: 600;
    selection-background-color: #CE93D8;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid #7B1FA2;
}

QTextEdit {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 10px;
    padding: 10px;
    font-size: 15px;
    color: #4A148C;
    font-weight: 600;
}

QComboBox {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 15px;
    color: #4A148C;
    font-weight: 600;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    selection-background-color: #F3E5F5;
    selection-color: #4A148C;
    font-size: 15px;
}

QSpinBox {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 15px;
    color: #4A148C;
    font-weight: 600;
}

/* ============================================================
   LISTE WIDGET'LARI
   ============================================================ */
QListWidget {
    background-color: transparent;
    border: none;
    font-size: 15px;
}

QListWidget::item {
    padding: 12px 12px;
    border-radius: 10px;
    color: #4A148C;
    font-weight: 700;
    background-color: transparent;
}

QListWidget::item:hover {
    background-color: rgba(206, 147, 216, 0.22);
    color: #4A148C;
}

QListWidget::item:selected {
    background-color: #E8D0FF;
    color: #4A148C;
    font-weight: 900;
}

/* ============================================================
   TABLO
   ============================================================ */
QTableWidget {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 10px;
    gridline-color: #CE93D8;
    font-size: 15px;
    color: #4A148C;
    font-weight: 600;
}

QHeaderView::section {
    background-color: #582C8C;
    color: #F0D0FF;
    padding: 10px;
    border: none;
    font-size: 14px;
    font-weight: 800;
}

/* ============================================================
   KAYDIRMA CUBUKLARI
   ============================================================ */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #CE93D8;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #AB47BC;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background-color: #CE93D8;
    border-radius: 6px;
    min-width: 28px;
}

/* ============================================================
   DIKME ELEMANLARI
   ============================================================ */
QLabel {
    color: #4A148C;
    font-size: 15px;
    font-weight: 700;
}

/* Kart icindeki etiketler koyu mor */
#statCard QLabel, #lessonCard QLabel, #previewCard QLabel,
#summaryCard QLabel, #achievementCard QLabel, #whyBox QLabel,
#syntaxBox QLabel {
    color: #4A148C;
    font-weight: 600;
}

QSplitter::handle {
    background-color: #CE93D8;
    width: 3px;
}

QRadioButton {
    color: #CE93D8;
    font-size: 15px;
    font-weight: 600;
    spacing: 8px;
}

/* ============================================================
   DIYALOGLAR (QDialog, QMessageBox)
   ============================================================ */
QDialog {
    background-color: #582C8C;
}

QDialog QLabel {
    color: #F0D0FF;
    font-size: 15px;
    font-weight: 600;
}

QDialog QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #4A148C;
    font-weight: 600;
}

QDialog QComboBox {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #4A148C;
    font-weight: 600;
}

QDialog QTextEdit {
    background-color: #FFFFFF;
    border: 2px solid #BA68C8;
    border-radius: 8px;
    padding: 8px;
    font-size: 14px;
    color: #4A148C;
    font-weight: 600;
}

QDialog QPushButton {
    background-color: #FFFFFF;
    color: #4A148C;
    border: 2px solid #CE93D8;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 800;
}

QDialog QPushButton:hover {
    background-color: #F3E5F5;
    border-color: #7B1FA2;
}

QMessageBox {
    background-color: #582C8C;
}

QMessageBox QLabel {
    color: #F0D0FF;
    font-size: 15px;
    font-weight: 600;
}

QMessageBox QPushButton {
    background-color: #FFFFFF;
    color: #4A148C;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 14px;
    font-weight: 800;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #F3E5F5;
}

QDialogButtonBox QPushButton {
    background-color: #FFFFFF;
    color: #4A148C;
    border: 2px solid #CE93D8;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 800;
}

QDialogButtonBox QPushButton:hover {
    background-color: #F3E5F5;
}

QFormLayout QLabel {
    color: #F0D0FF;
    font-size: 14px;
    font-weight: 700;
}
